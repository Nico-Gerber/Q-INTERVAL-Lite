# Backend settings. Copy to backend/.env and fill in. Never commit the real file.
# The backend only reads this at startup: restart uvicorn after changing it.

# "development" locally, "production" on Railway. Production refuses to start with unsafe settings
# (non-https origins, auth off, missing keys) and hides the /docs page.
APP_ENV=development

# Browser origins allowed to call the API, comma-separated. Must be https:// in production.
ALLOWED_ORIGINS=http://localhost:3000

# Supabase > Project Settings > API. The service-role key bypasses all security rules: backend only, keep it secret.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI explanations (https://openrouter.ai). The default models are free-tier and get retired from time to time:
# list backups in the *_FALLBACKS variables (comma-separated).
OPENROUTER_API_KEY=your-openrouter-key
# OPENROUTER_VLM_MODEL=google/gemma-4-31b-it:free      # must accept image input
# OPENROUTER_TEXT_MODEL=                               # defaults to the VLM model
# OPENROUTER_VLM_FALLBACKS=
# OPENROUTER_TEXT_FALLBACKS=

# Model weights. Files missing from backend/routers/*/models are downloaded from this Hugging Face repo at startup
# (the 2.6 GB convnextv2h_model_bundle.pth is not in git). HF_TOKEN is only needed if the repo is private.
HF_MODEL_REPO=owner/q-interval-models
HF_TOKEN=
# HF_MODEL_REVISION=main

# Require a valid approved Supabase login on analysis endpoints. Only ever set to false for local debugging.
REQUIRE_AUTH=true

# Analyses at once. Keep at 1: a classical analysis peaks at roughly 2.5 GB of RAM.
MAX_CONCURRENT_ANALYSES=1

# CPU threads for PyTorch (e.g. 4 on a cloud host that exposes many cores). 0 = library default.
# TORCH_NUM_THREADS=0

# Classical future-risk engine: v2c (default) or v2d (needs the two extra v2d files from the Hugging Face repo).
# FUTURE_RISK_ENGINE=v2c

LOG_LEVEL=INFO
