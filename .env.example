# Frontend settings. Copy to .env.local (same folder as package.json) and fill in.
# React only reads this file at startup: restart `npm start` after changing it.

# Where the backend runs. Local: http://localhost:8000. Deployed: your Railway URL.
REACT_APP_API_BASE=http://localhost:8000

# Supabase > Project Settings > API. The anon key is safe to expose in the browser; never put the service-role key here.
REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key
